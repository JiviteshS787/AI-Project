    if key:
        API_KEYS.append(key)
if not API_KEYS:
    raise RuntimeError("No Groq API keys found. Set GROQ_API_KEY_1 (and optionally GROQ_API_KEY_2).")

_current_key_index = 0


def _build_client():
    return Groq(api_key=API_KEYS[_current_key_index])

client = _build_client()
tracker = UsageTracker()

def _switch_to_next_key():
    """Rotate to the next available API key. Returns False if no more keys left."""
    global _current_key_index, client
    if _current_key_index + 1 >= len(API_KEYS):
        return False
    _current_key_index += 1
    client = _build_client()
    print(f"[key rotation] Switched to API key #{_current_key_index + 1}")
    return True

